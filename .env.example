# Reference values only: Spring Boot does not automatically load this file.
# Export needed variables in the shell or set them in the IDE/container environment.
PORT=8000
CHUNK_SIZE_WORDS=550
CHUNK_OVERLAP_WORDS=90

# Reserved for the PostgreSQL persistence milestone; not consumed by this baseline.
# JDBC URL and credentials are separate. Compose still uses its checked-in local defaults.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/akh
SPRING_DATASOURCE_USERNAME=akh
SPRING_DATASOURCE_PASSWORD=akh

# Reserved for later GCP and AI milestones; no cloud calls are made yet.
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-south1
VERTEX_LOCATION=asia-south1
EMBEDDING_MODEL=configure-current-vertex-embedding-model
GENERATION_MODEL=configure-current-gemini-model
