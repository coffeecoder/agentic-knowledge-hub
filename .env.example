# Reference values only: Spring Boot does not automatically load this file.
# Export needed variables in the shell or set them in the IDE/container environment.
PORT=8000
CHUNK_SIZE_WORDS=550
CHUNK_OVERLAP_WORDS=90
PROCESSING_REVISION=parsers-v1/chunker-v2
AKH_TENANT=local
AKH_SOURCE_NAME=manual-text

# Active PostgreSQL persistence settings.
# JDBC URL and credentials are separate. Compose still uses its checked-in local defaults.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/akh
SPRING_DATASOURCE_USERNAME=akh
SPRING_DATASOURCE_PASSWORD=akh

# Active Identity Platform project for token verification.
GCP_PROJECT_ID=agentic-knowledge-hub-learning

# Embeddings: none (keyword-only), local-hash (offline demo), ollama, or vertex.
EMBEDDING_PROVIDER=none
EMBEDDING_REVISION=v1
EMBEDDING_MAX_CHUNKS=16
EMBEDDING_TIMEOUT_SECONDS=15
EMBEDDING_ATTEMPTS=2
# Schema currently supports exactly 768 dimensions. No automatic provider fallback.
VERTEX_PROJECT_ID=agentic-knowledge-hub-learning
VERTEX_LOCATION=us-central1
VERTEX_EMBEDDING_MODEL=gemini-embedding-001
OLLAMA_EMBEDDING_URL=http://localhost:11434/api/embed
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:v1.5
# Optional prefixes default to "search_document: " and "search_query: ".
# Override akh.embedding.ollama.document-prefix/query-prefix for another model.

# Reserved for later deployment and answer generation.
GCP_REGION=asia-south1
GENERATION_MODEL=configure-current-gemini-model

# The dev profile exposes Swagger; API authentication remains mandatory.
# SPRING_PROFILES_ACTIVE=dev
